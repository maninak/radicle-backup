[Unit]
Description=Daily Radicle backup
Documentation=man:rad-backup(1)

[Timer]
OnCalendar=*-*-* 03:00:00
# Spreads the load, so every machine does not hit its seed at 03:00:00
RandomizedDelaySec=1h
# A laptop asleep at 03:00 backs up when it wakes
Persistent=true
Unit=rad-backup.service

[Install]
WantedBy=timers.target
