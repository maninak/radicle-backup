# Settings for the rad-backup user timer. Copy to ~/.config/rad-backup/env and edit.
#
#   systemctl --user enable --now rad-backup.timer
#   systemctl --user list-timers rad-backup.timer
#   journalctl --user -u rad-backup.service -n 50
#
# systemd does not expand anything in this file: no ~, no $HOME, no %h. Write absolute paths.

# Where archives go. Another disk, another machine's mount, or a directory a sync client
# already carries off this machine. An archive that shares a filesystem with the home it
# protects and goes nowhere else survives a mistake but not a dead disk.
RAD_BACKUP_DIR=/home/you/backups/radicle

# The archive passphrase, read from a file so it stays out of the process table. Create it
# with `install -m 600 /dev/null ~/.config/rad-backup/passphrase` and write one line into it.
RAD_BACKUP_PASSPHRASE_FILE=/home/you/.config/rad-backup/passphrase

# How much to carry: identity, state (the default) or full.
RAD_BACKUP_TIER=state

# Keep this many archives of this identity in RAD_BACKUP_DIR, deleting the oldest beyond it.
RAD_BACKUP_KEEP=14

# The Radicle home, if it is not ~/.radicle.
#RAD_HOME=/home/you/.radicle
