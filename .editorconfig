root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Matches rustfmt, so an editor agrees with it before the formatter runs
[*.rs]
indent_size = 4
max_line_length = 100

# just is whitespace-sensitive about how recipes are indented
[justfile]
indent_size = 4

# Tabs, because a test reads `assets/restore.sh` back and matches on its indentation
[*.sh]
indent_style = tab

# A trailing double space is a line break in markdown, so trimming it changes the text
[*.md]
trim_trailing_whitespace = false
